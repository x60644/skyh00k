# skyh00k Supabase creds — copy this file to `supabase.env` (same folder) and
# fill in the two values. Without it the laptop watcher can't authenticate, so
# the app's RUN NOW button queues a request that never gets picked up (it sits
# `pending` in Supabase and the button stays stuck on QUEUED), and build_slate
# can't merge the Line Book. `supabase.env` is gitignored; this template is not.
#
# Both values are the SAME public anon URL + key the frontend already uses —
# copy them from the Vercel project env vars:
#   SUPABASE_URL  = VITE_SUPABASE_URL
#   SUPABASE_KEY  = VITE_SUPABASE_ANON_KEY   (the legacy "eyJ..." anon key)
# They're also visible in the deployed frontend bundle, so they are not secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=eyJ...your-anon-key...
